# ==============================================================================
# J.A.R.V.I.S. Environment Configuration
# ==============================================================================
# Copy this file to .env (or run setup.bat / setup.sh) and enter your credentials.
# All fields are optional. Without an API key, local system commands still function.

# --- Hugging Face / Model Download Settings ---
HF_HUB_DISABLE_XET=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# --- LLM API 1: Google Gemini (Primary / Vision) ---
# Get your free Gemini API key at: https://aistudio.google.com/app/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite

# --- LLM API 2: Nex-N 2.5 / OpenRouter / Ollama (Seamless Fallback) ---
# Configure Nex-N 2.5 as a complementary brain alongside Gemini.
# If Gemini or Nex encounters rate limits (429) or errors, Jarvis automatically fails over.
# OpenRouter (Free tier / Pay-as-you-go):
# Get key at: https://openrouter.ai/
NEX_API_KEY=
NEX_BASE_URL=https://openrouter.ai/api/v1
NEX_MODEL=nex-agi/nex-n2.5-mini:free
# Or for local offline Ollama:
# NEX_BASE_URL=http://localhost:11434/v1
# NEX_MODEL=nex-n2.5-mini

# --- Assistant Persona ---
ASSISTANT_NAME=Jarvis
WAKE_WORDS=hey jarvis,hi jarvis,ok jarvis,okay jarvis,jarvis

# --- Text-to-Speech (TTS) Settings ---
# Default: High-definition British neural voice via Edge-TTS (free, no API key required)
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+0%
TTS_PITCH=-2Hz

# --- Optional: Fish Audio (Zero-Shot Paul Bettany Voice Cloning) ---
# Sign up at https://fish.audio to get an API key.
# Leave blank to use free built-in Edge-TTS (en-GB-RyanNeural).
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=88b183bfbdda44a09ad4474712b967f4
FISH_AUDIO_MODEL=s2.1-pro-free

# --- Email Reading & Summarization (Optional IMAP) ---
# For Gmail: Enable 2-Step Verification, then create a 16-character App Password at:
# https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_SERVER=imap.gmail.com

# --- Google Calendar Integration (Optional iCal Sync) ---
# In Google Calendar Web: Settings -> Click your calendar -> 'Integrate calendar'
# Copy your 'Secret address in iCal format' (.ics URL):
GOOGLE_CALENDAR_URL=

# --- Speech Recognition (faster-whisper) ---
# Options: distil-small.en, distil-medium.en, base.en, small.en, large-v3-turbo
WHISPER_MODEL=distil-small.en

# --- Silero Neural VAD (Handy Architecture) ---
# Speech probability threshold (0.0 - 1.0, default 0.50). Rejects keyboard typing, fan noise, and coughing.
VAD_THRESHOLD=0.50
# Dynamic End-of-Speech silence cutoff in seconds (default 0.35s = 350ms vs old 800ms). Instant turnaround.
VAD_PAUSE_SECONDS=0.35
# Microphone index or name (leave blank for system default)
MIC_DEVICE=
# Speech detection sensitivity (leave blank for automatic background calibration)
MIC_THRESHOLD=
# Push-to-talk key (used with --ptt)
PTT_KEY=right ctrl

# --- Floating Dynamic Island Widget ---
# Global hotkey to toggle widget (e.g. alt+space, ctrl+space, ctrl+shift+j)
WIDGET_HOTKEY=alt+space
